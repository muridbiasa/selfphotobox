# ─── MIDTRANS ───────────────────────────────────────────────
# Server Key: hanya di Vercel env (JANGAN expose ke frontend!)
# Dapatkan dari: dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxxxx

# Client Key: boleh di frontend (dipakai di index.html Snap SDK)
VITE_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxx

# ─── GOOGLE APPS SCRIPT ─────────────────────────────────────
# Deploy GAS sebagai Web App → dapat URL seperti di bawah
# Paste di Vercel env (bukan VITE_ karena dipakai server-side saja)
GAS_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXX/exec

# ─── APP ────────────────────────────────────────────────────
APP_URL=https://your-project.vercel.app
